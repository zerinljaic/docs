{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Mint Starter Kit",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Community",
          "icon": "slack",
          "href": "https://mintlify.com/community"
        },
        {
          "anchor": "Blog",
          "icon": "newspaper",
          "href": "https://mintlify.com/blog"
        }
      ]
    },
    "dropdowns": [
      {
        "dropdown": "Untitled Dropdown",
        "tabs": [
          {
            "tab": "Test",
            "pages": [
              "test/untitled-page-3",
              "test/untitled-page-2",
              "test/untitled-page-1",
              "test/untitled-page",
              "test/test-3",
              "test/test-2",
              "test/test-1"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hi@mintlify.com"
      }
    ],
    "primary": {
      "type": "button",
